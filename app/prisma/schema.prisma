generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("parent") // admin | teacher | accountant | parent | driver
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  teacher   Teacher?
  parent    Parent?
  driver    Driver?

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── SCHOOL STRUCTURE ────────────────────────────────────────────────────────

model ClassSection {
  id        String   @id @default(cuid())
  name      String
  grade     Int
  section   String
  year      Int      @default(2026)
  createdAt DateTime @default(now())

  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  teacherId   String?
  students    Student[]
  assignments Assignment[]
  attendance  Attendance[]

  @@unique([grade, section, year])
  @@map("class_sections")
}

// ─── PEOPLE ──────────────────────────────────────────────────────────────────

model Student {
  id             String    @id @default(cuid())
  name           String
  nameUrdu       String?
  rollNumber     String?
  gender         String    @default("M")
  dateOfBirth    DateTime?
  admissionDate  DateTime  @default(now())
  status         String    @default("active")
  previousSchool String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  classSectionId String
  parent         Parent?      @relation(fields: [parentId], references: [id])
  parentId       String?
  busStop        BusStop?     @relation(fields: [busStopId], references: [id])
  busStopId      String?

  attendance    Attendance[]
  grades        Grade[]
  feePayments   FeePayment[]
  leaveRequests LeaveRequest[]
  aiSessions    AiSession[]

  @@map("students")
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  employeeId    String   @unique
  phone         String?
  subject       String?
  qualification String?
  joinDate      DateTime @default(now())
  status        String   @default("active")

  user        User           @relation(fields: [userId], references: [id])
  classes     ClassSection[]
  assignments Assignment[]

  @@map("teachers")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String
  whatsapp  String?
  address   String?
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  students      Student[]
  leaveRequests LeaveRequest[]

  @@map("parents")
}

model Driver {
  id        String   @id @default(cuid())
  userId    String   @unique
  licenseNo String?
  phone     String?
  status    String   @default("active")

  user   User    @relation(fields: [userId], references: [id])
  routes Route[]

  @@map("drivers")
}

// ─── ACADEMICS ───────────────────────────────────────────────────────────────

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String
  markedAt  DateTime @default(now())
  markedBy  String?

  student        Student      @relation(fields: [studentId], references: [id])
  studentId      String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  classSectionId String

  @@unique([studentId, date])
  @@map("attendance")
}

model Grade {
  id        String   @id @default(cuid())
  subject   String
  term      String
  year      Int      @default(2026)
  quiz1     Float?
  quiz2     Float?
  quiz3     Float?
  finalExam Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  @@unique([studentId, subject, term, year])
  @@map("grades")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  subject     String
  description String?
  dueDate     DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())

  classSection   ClassSection @relation(fields: [classSectionId], references: [id])
  classSectionId String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  teacherId      String

  @@map("assignments")
}

// ─── FINANCE ─────────────────────────────────────────────────────────────────

model FeeStructure {
  id            String   @id @default(cuid())
  grade         Int
  type          String
  amount        Float
  frequency     String   @default("monthly")
  year          Int      @default(2026)
  effectiveFrom DateTime @default(now())

  @@unique([grade, type, year])
  @@map("fee_structures")
}

model FeePayment {
  id        String    @id @default(cuid())
  month     String
  amount    Float
  charged   Float
  status    String    @default("pending")
  method    String?
  paidAt    DateTime?
  reference String?
  notes     String?
  createdAt DateTime  @default(now())

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  @@unique([studentId, month])
  @@map("fee_payments")
}

model Expense {
  id         String   @id @default(cuid())
  title      String
  category   String
  amount     Float
  status     String   @default("pending")
  date       DateTime
  approvedBy String?
  createdAt  DateTime @default(now())

  @@map("expenses")
}

// ─── COMMUNICATION ───────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  priority  String   @default("normal")
  audience  String   @default("all")
  createdBy String
  createdAt DateTime @default(now())

  @@map("announcements")
}

model LeaveRequest {
  id         String    @id @default(cuid())
  type       String
  dates      String
  reason     String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  student   Student @relation(fields: [studentId], references: [id])
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id])
  parentId  String

  @@map("leave_requests")
}

// ─── TRANSPORT ───────────────────────────────────────────────────────────────

model Route {
  id     String  @id @default(cuid())
  name   String
  code   String  @unique
  active Boolean @default(true)

  driver   Driver?   @relation(fields: [driverId], references: [id])
  driverId String?
  stops    BusStop[]

  @@map("routes")
}

model BusStop {
  id       String  @id @default(cuid())
  name     String
  sequence Int
  landmark String?
  etaMins  Int?

  route     Route     @relation(fields: [routeId], references: [id])
  routeId   String
  students  Student[]

  @@map("bus_stops")
}

// ─── AI COMPANION ────────────────────────────────────────────────────────────

model AiSession {
  id        String    @id @default(cuid())
  grade     Int
  subject   String
  messages  String
  tokenUsed Int       @default(0)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  @@map("ai_sessions")
}
